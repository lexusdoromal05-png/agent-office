# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# ─── Cypher (operations agent) ───────────────────────────────────────────────
# Every connector is optional. Anything left blank is reported as an ACCESS GAP
# in each brief instead of being silently skipped.

# How you appear in author fields, so Cypher can spot your messages, mentions,
# promises, and follow-ups. Comma-separated.
OPS_ME_NAMES=
# Model used for briefs (defaults to OLLAMA_MODEL). Bigger is better here.
OPS_MODEL=
# Action types Cypher may execute WITHOUT asking (standing authorization).
# Leave empty to approve everything yourself. Supported: slack_message, jira_comment
OPS_STANDING_AUTH=

# Slack — user token (xoxp-) with search:read (reading). SLACK_BOT_TOKEN with
# chat:write is used for approved sends; falls back to the user token.
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
SLACK_MY_USER_ID=

# Google (Gmail, Calendar, Drive/Docs/Sheets/Slides) — OAuth client plus a refresh
# token with gmail.readonly, calendar.readonly, drive.readonly scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Files always read in full on every sweep (product sheet, KPI sheet…). Comma-separated IDs.
GOOGLE_WATCH_FILE_IDS=

# Jira Cloud — API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: limit to these project keys, e.g. "OPS, TOMO"
JIRA_PROJECTS=

# Notion — internal integration token; share the relevant pages with the integration.
NOTION_TOKEN=

# Discord — bot token and the channel IDs to read.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# WhatsApp Business Cloud API webhook (POST /api/webhooks/whatsapp). Only messages
# sent to the connected business number are visible; personal chats have no API.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Push anything else (meeting transcripts, CRM events, dashboards) to POST /api/ops/ingest
# with "Authorization: Bearer <token>".
OPS_INGEST_TOKEN=
